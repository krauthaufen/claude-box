#!/usr/bin/env bash
# claude-box — run Claude Code inside a Docker container (Linux / macOS).
# Only the current directory and the Claude config dirs are mounted, at their real
# host paths, so sessions / --resume / --continue are shared with the host CLI.
set -euo pipefail

SRC="${BASH_SOURCE[0]}"; while [[ -L "$SRC" ]]; do l="$(readlink "$SRC")"; [[ "$l" == /* ]] && SRC="$l" || SRC="$(dirname "$SRC")/$l"; done
REPO="$(cd "$(dirname "$SRC")" && pwd -P)"
U_ID="$(id -u)"; G_ID="$(id -g)"; U_NAME="$(id -un)"

# --- Config: global package list + optional root setup script ----------------
CONF_DIR="${CLAUDE_BOX_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-box}"
PKG_FILE="$CONF_DIR/packages"; SETUP_FILE="$CONF_DIR/setup.sh"
[[ -f "$PKG_FILE" ]] || { mkdir -p "$CONF_DIR"; cp "$REPO/packages.default" "$PKG_FILE"; }
PACKAGES="$(sed 's/#.*//' "$PKG_FILE" | tr -d '\r' | tr -s ' \t\n' ' ' | sed 's/^ //;s/ $//')"
SETUP_B64=""; [[ -f "$SETUP_FILE" ]] && SETUP_B64="$(base64 < "$SETUP_FILE" | tr -d '\n')"

# --- Claude version: match the host CLI if installed, else latest ------------
VERSION="${CLAUDE_BOX_VERSION:-}"
if [[ -z "$VERSION" ]] && command -v claude >/dev/null 2>&1; then
  VERSION="$(claude --version 2>/dev/null | awk '{print $1}')" || true
fi
VERSION="${VERSION:-latest}"

# --- Image: one tag per (version, user, Dockerfile+packages+setup) -----------
HASH="$( { cat "$REPO/Dockerfile"; printf '|%s|%s|%s' "$PACKAGES" "$SETUP_B64" "$HOME"; } | (sha256sum 2>/dev/null || shasum -a 256) | cut -c1-10)"
TAG="${CLAUDE_BOX_IMAGE:-claude-box}:${VERSION}-${U_ID}-${HASH}"
if [[ "${1:-}" == "--box-rebuild" ]]; then shift; docker image rm -f "$TAG" >/dev/null 2>&1 || true; fi
if ! docker image inspect "$TAG" >/dev/null 2>&1; then
  echo "claude-box: building image $TAG (one-time, a few minutes)..." >&2
  docker build -t "$TAG" -f "$REPO/Dockerfile" \
    --build-arg UID="$U_ID" --build-arg GID="$G_ID" --build-arg UNAME="$U_NAME" \
    --build-arg HOMEDIR="$HOME" --build-arg VERSION="$VERSION" \
    --build-arg PACKAGES="$PACKAGES" --build-arg SETUP_B64="$SETUP_B64" "$REPO" >&2
fi

# --- Mounts: CWD + config dirs at identical paths ----------------------------
CWD="$(pwd -P)"
MOUNTS=(-w "$CWD"); SEEN="|"
add_mount() { [[ -e "$1" && "$SEEN" != *"|$1|"* ]] || return 0; SEEN="$SEEN$1|"; MOUNTS+=(-v "$1:$1"); }
add_mount "$CWD"
if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then
  CFG="$CLAUDE_CONFIG_DIR"; mkdir -p "$CFG"; MOUNTS+=(-e "CLAUDE_CONFIG_DIR=$CFG")
else
  CFG="$HOME/.claude"; mkdir -p "$CFG"
  [[ -e "$HOME/.claude.json" ]] || echo '{}' > "$HOME/.claude.json"
  add_mount "$HOME/.claude.json"
fi
add_mount "$CFG"
for e in "$CFG"/* "$CFG"/.[!.]*; do   # follow top-level symlinks leaving the config dir
  [[ -L "$e" ]] || continue
  t="$(readlink -f "$e" 2>/dev/null)" || continue
  [[ "$t" == "$CFG"/* ]] || add_mount "$t"
done
# files pulled in by the global CLAUDE.md (@/abs or @~/ imports) and a custom autoMemoryDirectory
for md in "$CFG"/CLAUDE.md "$CFG"/rules/*.md; do
  [[ -f "$md" ]] || continue
  while IFS= read -r imp; do
    imp="${imp#@}"; imp="${imp/#\~/$HOME}"
    if [[ -e "$imp" ]]; then add_mount "$(cd "$(dirname "$imp")" && pwd -P)/$(basename "$imp")"; fi
  done < <(grep -oE '(^|[[:space:]])@(~|/)[^[:space:]]+' "$md" | sed 's/^[[:space:]]*//' || true)
done
for sf in "$CFG/settings.json" "$CFG/settings.local.json"; do
  [[ -f "$sf" ]] || continue
  amd="$(sed -nE 's/.*"autoMemoryDirectory"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$sf" | head -1)"
  if [[ -n "$amd" ]]; then amd="${amd/#\~/$HOME}"; mkdir -p "$amd"; add_mount "$amd"; fi
done
for extra in ${CLAUDE_BOX_MOUNTS:-}; do add_mount "$extra"; done

# --- Env passthrough ---------------------------------------------------------
ENVS=()
for v in TERM COLORTERM TZ ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL \
         CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX AWS_REGION AWS_PROFILE CLOUD_ML_REGION \
         ANTHROPIC_VERTEX_PROJECT_ID HTTP_PROXY HTTPS_PROXY NO_PROXY ${CLAUDE_BOX_ENV:-}; do
  if [[ -n "${!v:-}" ]]; then ENVS+=(-e "$v=${!v}"); fi
done

TTY=(-i); [[ -t 0 && -t 1 ]] && TTY=(-it)
exec docker run --rm "${TTY[@]}" --hostname "$(hostname)" \
  ${CLAUDE_BOX_DOCKER_ARGS:-} "${MOUNTS[@]}" ${ENVS[@]+"${ENVS[@]}"} "$TAG" "$@"

#!/usr/bin/env bash
# claude-box — run Claude Code isolated in a container (Linux / macOS; docker or podman).
#
# Isolation model: nothing the container writes can be executed by the host afterwards.
#  - The box has its OWN config dir (private state), mounted at the host config path.
#    Host CLAUDE.md / settings / skills / agents / commands / plugins are COPIED in on every
#    launch, so edits inside the box never reach the host.
#  - Shared writable with the host = data only: projects/ (sessions + memory, for --resume /
#    --continue), history.jsonl, file-history/, todos/.
#  - CWD is mounted read-write, except .claude/, .git/hooks and .git/config (read-only).
#  - Files @imported by the global CLAUDE.md are mounted read-only.
#  - No capabilities, no-new-privileges, no sudo, no docker socket, no other host paths.
#  - Full internet access; LAN/private ranges blocked per ~/.config/claude-box/network
#    (applied by the entrypoint as root, which then drops all capabilities).
set -euo pipefail

SRC="${BASH_SOURCE[0]}"; while [[ -L "$SRC" ]]; do l="$(readlink "$SRC")"; [[ "$l" == /* ]] && SRC="$l" || SRC="$(dirname "$SRC")/$l"; done
REPO="$(cd "$(dirname "$SRC")" && pwd -P)"
U_ID="$(id -u)"; G_ID="$(id -g)"; U_NAME="$(id -un)"
hash10() { (sha256sum 2>/dev/null || shasum -a 256) | cut -c1-10; }

# --- Container engine: docker, or podman (CLAUDE_BOX_ENGINE overrides) ---------
DOCKER="${CLAUDE_BOX_ENGINE:-}"
if [[ -z "$DOCKER" ]]; then
  found=(); for e in docker podman; do command -v "$e" >/dev/null 2>&1 && found+=("$e"); done
  (( ${#found[@]} )) || { echo "claude-box: neither docker nor podman found" >&2; exit 1; }
  DOCKER="${found[0]}"
  if (( ${#found[@]} > 1 )); then   # both installed: take the one that is running
    for e in "${found[@]}"; do if "$e" version --format '{{.Server.Version}}' >/dev/null 2>&1; then DOCKER="$e"; break; fi; done
  fi
fi
# Rootless podman: map the box user to your own user, so files it writes are yours.
USERNS=()
if [[ "$(basename "$DOCKER")" == podman* && "$("$DOCKER" info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" == true ]]; then
  USERNS=(--userns="keep-id:uid=$U_ID,gid=$G_ID")
fi

# --- Global package list + optional root setup script (build time only) -------
CONF_DIR="${CLAUDE_BOX_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-box}"
PKG_FILE="$CONF_DIR/packages"; SETUP_FILE="$CONF_DIR/setup.sh"
[[ -f "$PKG_FILE" ]] || { mkdir -p "$CONF_DIR"; cp "$REPO/packages.default" "$PKG_FILE"; }
PACKAGES="$(sed 's/#.*//' "$PKG_FILE" | tr -d '\r' | tr -s ' \t\n' ' ' | sed 's/^ //;s/ $//')"
NET_FILE="$CONF_DIR/network"
[[ -f "$NET_FILE" ]] || cp "$REPO/network.default" "$NET_FILE"
NET_RULES="$(sed 's/#.*//' "$NET_FILE" | tr -d '\r' | grep -v '^[[:space:]]*$' || true)"
SETUP_B64=""; if [[ -f "$SETUP_FILE" ]]; then SETUP_B64="$(base64 < "$SETUP_FILE" | tr -d '\n')"; fi

# --- Claude version: match the host CLI if installed, else latest ------------
VERSION="${CLAUDE_BOX_VERSION:-}"
if [[ -z "$VERSION" ]] && command -v claude >/dev/null 2>&1; then
  VERSION="$(claude --version 2>/dev/null | awk '{print $1}')" || true
fi
VERSION="${VERSION:-latest}"

# --- Image ---------------------------------------------------------------------
HASH="$( { cat "$REPO/Dockerfile" "$REPO/entry.sh"; printf '|%s|%s|%s' "$PACKAGES" "$SETUP_B64" "$HOME"; } | hash10)"
TAG="${CLAUDE_BOX_IMAGE:-claude-box}:${VERSION}-${U_ID}-${HASH}"
if [[ "${1:-}" == "--box-rebuild" ]]; then shift; "$DOCKER" image rm -f "$TAG" >/dev/null 2>&1 || true; fi
if ! "$DOCKER" image inspect "$TAG" >/dev/null 2>&1; then
  echo "claude-box: building image $TAG (one-time, a few minutes)..." >&2
  for attempt in 1 2 3; do   # finished layers are cached, so a retry only redoes the failed step
    if "$DOCKER" build -t "$TAG" -f "$REPO/Dockerfile" \
      --build-arg UID="$U_ID" --build-arg GID="$G_ID" --build-arg UNAME="$U_NAME" \
      --build-arg HOMEDIR="$HOME" --build-arg VERSION="$VERSION" \
      --build-arg PACKAGES="$PACKAGES" --build-arg SETUP_B64="$SETUP_B64" "$REPO" >&2; then break; fi
    if (( attempt == 3 )); then echo "claude-box: image build failed" >&2; exit 1; fi
    echo "claude-box: build failed (attempt $attempt), retrying..." >&2; sleep 5
  done
fi

# --- Config: host config path + box-private state dir --------------------------
if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then CFG="$CLAUDE_CONFIG_DIR"; HJSON="$CFG/.claude.json"
else CFG="$HOME/.claude"; HJSON="$HOME/.claude.json"; fi
mkdir -p "$CFG"
STATE="${CLAUDE_BOX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-box}/$(printf '%s' "$CFG" | hash10)"
BOXCFG="$STATE/config"
mkdir -p "$BOXCFG"
# Serialize seeding/refresh between concurrently starting launchers (mkdir is atomic).
LOCK="$BOXCFG/.launch.lock"; n=0
until mkdir "$LOCK" 2>/dev/null; do
  n=$((n+1)); if (( n > 300 )); then rm -rf "$LOCK"; n=0; fi   # stale after ~30s
  sleep 0.1
done
trap 'rm -rf "$LOCK"' EXIT
# box-private .claude.json, seeded once from the host (never written back). It lives inside the
# config dir (CLAUDE_CONFIG_DIR is always set in the box) so Claude's own lock is shared by boxes.
if [[ ! -s "$BOXCFG/.claude.json" ]]; then
  if [[ -f "$HJSON" ]]; then cp "$HJSON" "$BOXCFG/.claude.json.seed"; else echo '{}' > "$BOXCFG/.claude.json.seed"; fi
  mv -f "$BOXCFG/.claude.json.seed" "$BOXCFG/.claude.json"
fi
# refresh copies of host instructions/settings/extensions (box edits are discarded);
# copy-then-swap so already running boxes never see a half-copied tree
for item in CLAUDE.md settings.json settings.local.json keybindings.json skills agents commands rules output-styles plugins; do
  tmp="$BOXCFG/.incoming-$item"; old="$BOXCFG/.old-$item"; rm -rf "$tmp" "$old"
  if [[ -e "$CFG/$item" ]]; then cp -RL "$CFG/$item" "$tmp" 2>/dev/null || true; fi
  if [[ -e "$BOXCFG/$item" ]]; then mv "$BOXCFG/$item" "$old"; fi
  if [[ -e "$tmp" ]]; then mv "$tmp" "$BOXCFG/$item"; fi
  rm -rf "$old"
done
rm -rf "$LOCK"; trap - EXIT
# shared data (real dirs, resolved through symlinks)
SHARED=()
for d in projects file-history todos; do
  [[ -e "$CFG/$d" ]] || mkdir -p "$CFG/$d"
  SHARED+=(-v "$(cd "$CFG/$d" && pwd -P):$CFG/$d")
done
H="$CFG/history.jsonl"; [[ -e "$H" ]] || : > "$H"
SHARED+=(-v "$(cd "$(dirname "$(readlink -f "$H")")" && pwd -P)/$(basename "$(readlink -f "$H")"):$CFG/history.jsonl")

MOUNTS=(-v "$BOXCFG:$CFG" -e "CLAUDE_CONFIG_DIR=$CFG")
MOUNTS+=("${SHARED[@]}")

# --- CWD, with host-executed bits read-only --------------------------------------
CWD="$(pwd -P)"
case "$CWD" in "$HOME"|/) echo "claude-box: refusing to mount $CWD as the project dir" >&2; exit 1;; esac
MOUNTS+=(-v "$CWD:$CWD" -w "$CWD")
mkdir -p "$CWD/.claude"; MOUNTS+=(-v "$CWD/.claude:$CWD/.claude:ro")
if [[ -d "$CWD/.git" ]]; then
  mkdir -p "$CWD/.git/hooks"; MOUNTS+=(-v "$CWD/.git/hooks:$CWD/.git/hooks:ro")
  if [[ -f "$CWD/.git/config" ]]; then MOUNTS+=(-v "$CWD/.git/config:$CWD/.git/config:ro"); fi
fi
for f in .mcp.json CLAUDE.local.md .envrc; do
  if [[ -f "$CWD/$f" ]]; then MOUNTS+=(-v "$CWD/$f:$CWD/$f:ro"); fi
done
# files imported by the global CLAUDE.md (@/abs or @~/...): read-only, single files only
for md in "$CFG"/CLAUDE.md "$CFG"/rules/*.md; do
  [[ -f "$md" ]] || continue
  while IFS= read -r imp; do
    imp="${imp#@}"; imp="${imp/#\~/$HOME}"
    if [[ -f "$imp" ]]; then MOUNTS+=(-v "$(readlink -f "$imp"):$imp:ro"); fi
  done < <(grep -oE '(^|[[:space:]])@(~|/)[^[:space:]]+' "$md" | sed 's/^[[:space:]]*//' || true)
done
for extra in ${CLAUDE_BOX_MOUNTS:-}; do   # explicit opt-in, always read-only
  if [[ -e "$extra" ]]; then MOUNTS+=(-v "$extra:$extra:ro"); fi
done

# --- Env passthrough ---------------------------------------------------------
ENVS=()
for v in TERM COLORTERM TZ ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL \
         CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX AWS_REGION CLOUD_ML_REGION \
         ANTHROPIC_VERTEX_PROJECT_ID HTTP_PROXY HTTPS_PROXY NO_PROXY ${CLAUDE_BOX_ENV:-}; do
  if [[ -n "${!v:-}" ]]; then ENVS+=(-e "$v=${!v}"); fi
done

# Git identity and line endings: pass the host's effective settings for this folder to git in the box.
n=0
if command -v git >/dev/null 2>&1; then
  for k in user.name user.email core.autocrlf core.eol; do
    v="$(git -C "$CWD" config --get "$k" 2>/dev/null || true)"
    if [[ -n "$v" ]]; then ENVS+=(-e "GIT_CONFIG_KEY_$n=$k" -e "GIT_CONFIG_VALUE_$n=$v"); n=$((n+1)); fi
  done
fi
if (( n > 0 )); then ENVS+=(-e "GIT_CONFIG_COUNT=$n"); fi

TTY=(-i); if [[ -t 0 && -t 1 ]]; then TTY=(-it); fi
exec "$DOCKER" run --rm "${TTY[@]}" ${USERNS[@]+"${USERNS[@]}"} --user 0:0 --hostname "$(hostname 2>/dev/null || uname -n)" \
  --cap-drop ALL --cap-add NET_ADMIN --cap-add SETUID --cap-add SETGID --cap-add SETPCAP --security-opt no-new-privileges --pids-limit 4096 --memory "${CLAUDE_BOX_MEMORY:-8g}" \
  ${CLAUDE_BOX_DOCKER_ARGS:-} "${MOUNTS[@]}" ${ENVS[@]+"${ENVS[@]}"} -e "CLAUDE_BOX_NET=$NET_RULES" "$TAG" "$@"
